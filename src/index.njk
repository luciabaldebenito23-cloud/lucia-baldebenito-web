<!-- ==================== 4. PROPIEDADES ==================== -->
<section class="section" id="propiedades">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow eyebrow-purple">Propiedades</p>
      <h2>Propiedades verificadas, con toda la información por delante</h2>
      <p class="section-sub">Elegí qué estás buscando. Cada ficha tiene el dato completo: nada de "consultar precio".</p>
    </div>

    <div class="hero-actions">
      <a href="/propiedades/ventas.html" class="btn btn-primary">Ventas</a>
      <a href="/propiedades/alquileres.html" class="btn btn-outline">Alquileres</a>
      <a href="/propiedades/emprendimientos.html" class="btn btn-outline">Emprendimientos</a>
    </div>

    <p class="eyebrow eyebrow-purple small properties-destacadas-label">Destacadas</p>

    <div class="cards-grid properties-grid" id="propertiesGrid">
      {% for item in destacadas %}
