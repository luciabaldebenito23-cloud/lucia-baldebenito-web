{% set destacadas = collections.propiedades | whereTrue("destacada") %}

<!-- ==================== 1. INICIO / HERO ==================== -->
<section class="hero" id="inicio">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow eyebrow-navy">Comodoro Rivadavia y Rada Tilly · Chubut</p>
      <h1 class="hero-title">Sabe, y te acompaña.</h1>
      <p class="hero-lead">
        Si tenés una propiedad parada y no sabés si venderla o alquilarla
        vos mismo/a o contratar una inmobiliaria: necesitás claridad.
        Proceso, costo y plazo, explicados antes de pedirte que decidas —
        y compañía hasta que la decisión esté tomada.
      </p>
      <div class="hero-actions">
        <a href="#propiedades" class="btn btn-primary">Ver propiedades</a>
        <a href="#tasaciones" class="btn btn-outline">Quiero tasar mi propiedad</a>
      </div>
      <ul class="hero-trust">
        <li><span class="trust-num">+5</span> años de experiencia condensados en un método propio</li>
        <li><span class="trust-num">2</span> caminos: te lo resolvemos o te enseñamos a resolverlo</li>
      </ul>
    </div>

    <div class="hero-visual">
      <div class="img-placeholder has-photo hero-photo">
        <img src="/img/hero-lucia.jpg" alt="Lucía Baldebenito trabajando en su escritorio" loading="lazy">
      </div>
      <div class="hero-search-card" aria-label="Buscador de propiedades">
        <p class="hero-search-title">Buscá tu próxima propiedad</p>
        <form class="search-form" id="heroSearchForm">
          <div class="search-row">
            <div class="field">
              <label for="searchOperacion">Operación</label>
              <select id="searchOperacion" name="operacion">
                <option value="venta">Venta</option>
                <option value="alquiler">Alquiler</option>
                <option value="emprendimiento">Emprendimiento</option>
              </select>
            </div>
            <div class="field">
              <label for="searchTipo">Tipo</label>
              <select id="searchTipo" name="tipo">
                <option value="">Todos</option>
                <option value="casa">Casa</option>
                <option value="departamento">Departamento</option>
                <option value="terreno">Terreno</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label for="searchZona">Zona o barrio</label>
            <input type="text" id="searchZona" name="zona" placeholder="Ej: Km 3, Rada Tilly…">
          </div>
          <button type="submit" class="btn btn-primary btn-block">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            Buscar propiedades
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<div class="divider" aria-hidden="true"><span class="rhombus"></span><span class="rhombus"></span><span class="rhombus"></span></div>

<!-- ==================== 2. SOBRE MÍ ==================== -->
